# Application
APP_NAME=ai-inquiry-processing-agent
APP_ENV=local
DEBUG=true

# Database (SQLite default — no real secrets)
DATABASE_URL=sqlite:///./data/app.db

# Excel sample data (relative to project root)
LDAP_USERS_PATH=data/sample/ldap_users.xlsx
GAC_USERS_PATH=data/sample/gac_users.xlsx
LDAP_COMPANIES_PATH=data/sample/ldap_companies.xlsx

# Domain similarity (RapidFuzz ratio 0-100)
SIMILARITY_THRESHOLD=80

# Confidence gate: confidence <= threshold → human review (do not trust LLM alone)
CONFIDENCE_REVIEW_THRESHOLD=0.99

# AI provider: ollama (default, supported runtime) | mock (CI/offline)
# Zero paid API dependencies for MVP.
AI_PROVIDER=ollama
APPROVAL_PROVIDER=mock
EMAIL_PROVIDER=mock
GRAPH_ENABLED=false
TEAMS_CALLBACK_SECRET=dev-teams-callback-secret

# Ollama (local Windows — qwen3:4b primary, qwen3:1.7b fallback)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODEL=qwen3:1.7b
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=300
# Keep false for demos — never silently replace Ollama with mock heuristics
OLLAMA_ALLOW_MOCK_FALLBACK=false

# Limited local RAG top-k (never dump all history into context)
RAG_TOP_K=3

# Workflow limits
WORKFLOW_MAX_TOOL_CALLS=20
WORKFLOW_MAX_RETRIES=2
WORKFLOW_STEP_TIMEOUT_SECONDS=60

# Optional OpenAI — NOT required for MVP; leave empty
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30

TEAMS_WEBHOOK_URL=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
